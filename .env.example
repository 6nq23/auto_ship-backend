

# Shopify customer-support lookup. Use either an offline Admin access token,
# or the client id/secret pair for OAuth token exchange.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# WhatsApp support automation. Supported providers: disabled, meta, whapi,
# and getgabs. Only fill the fields required by the selected provider.
WHATSAPP_PROVIDER=disabled
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_URL=
WHATSAPP_SERVICE_API_URL=
WHATSAPP_SENDER=
WHATSAPP_CAMPAIGN_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
SUPPORT_PHONE_NUMBER=
