# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Core (required) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173,https://auto-ship-client.vercel.app
PORT=3000

# Set true to run without NimbusPost/Shopify credentials (demo data only).
MOCK_MODE=false

# --- NimbusPost (required unless MOCK_MODE=true) ---
NIMBUS_API_KEY=
NIMBUS_API_SECRET=
NIMBUS_API_URL=https://api-v2.nimbuspost.com
NIMBUS_LOOKUP_MAX_PAGES=20

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# --- WhatsApp ---
# Provider is inferred from what you set: meta | whapi | getgabs | disabled
WHATSAPP_PROVIDER=getgabs
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_SENDER=
WHATSAPP_CAMPAIGN_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Support routing ---
SUPPORT_PHONE_NUMBER=
ESCALATION_PHONE=

# --- AI (the bot falls back to keyword matching when none of these are set) ---
# One key is enough. Providers are tried in order, failing over automatically.
# AI_PRIMARY_PROVIDER decides which one is tried first.
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_PROVIDER=gemini

# Model overrides — leave unset to use the built-in defaults.
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4.1-mini

# Automated turns allowed before the bot escalates to a human.
AI_MAX_TURNS=3
# Chat history characters sent to the AI; older messages are summarized past this.
AI_CONTEXT_MAX_CHARS=120000
# Customer conversations the bot answers at once. 1 = full attention, one at a time.
BOT_MAX_CONCURRENT_CHATS=1

# --- First run only ---
INITIAL_ADMIN_PASSWORD=
